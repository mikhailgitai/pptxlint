          },
          "properties": {
            "pptxlintInputKey": "a missing#.pptx",
            "pptxlintDisplayPath": "a missing#.pptx",
            "pptxlintAnalysisComplete": true,
            "pptxlintSkippedRules": []
          }
        },
        {
          "location": {
            "uri": "z-valid.pptx",
            "uriBaseId": "%SRCROOT%",
            "index": 1
          },
          "roles": [
            "analysisTarget"
          ],
          "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation",
          "hashes": {
