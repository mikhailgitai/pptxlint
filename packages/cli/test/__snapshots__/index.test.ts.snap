"{
  "version": "2.1.0",
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "pptxlint",
          "version": "0.1.1-beta.0",
          "semanticVersion": "0.1.1-beta.0",
          "rules": [
            {
              "id": "package/broken-relationship",
              "shortDescription": {
                "text": "Internal non-media relationship target is missing."
              },
              "defaultConfiguration": {
                "enabled": true,
                "level": "error"
              },
              "properties": {
                "prerequisites": [
                  "relationships"
                ]
              }
            },
            {
              "id": "package/missing-media",
              "shortDescription": {
                "text": "Media relationship target is missing."
              },
              "defaultConfiguration": {
                "enabled": true,
                "level": "error"
              },
              "properties": {
                "prerequisites": [
                  "relationships"
                ]
              }
            },
            {
              "id": "package/malformed-xml",
              "shortDescription": {
                "text": "Package XML part is not well-formed."
              },
              "defaultConfiguration": {
                "enabled": true,
                "level": "error"
              },
              "properties": {
                "prerequisites": [
                  "archive",
                  "xml"
                ]
              }
            },
            {
              "id": "layout/outside-slide",
              "shortDescription": {
                "text": "Shape extends beyond the slide boundary."
              },
              "defaultConfiguration": {
                "enabled": true,
                "level": "warning"
              },
              "properties": {
                "prerequisites": [
                  "presentation"
                ]
              }
            },
            {
              "id": "layout/text-overlap",
              "shortDescription": {
                "text": "Text-bearing shapes overlap."
              },
              "defaultConfiguration": {
                "enabled": true,
                "level": "warning"
              },
              "properties": {
                "prerequisites": [
                  "presentation"
                ]
              }
            },
            {
              "id": "layout/text-occluded",
              "shortDescription": {
                "text": "Text is occluded by a later opaque shape."
              },
              "defaultConfiguration": {
                "enabled": false,
                "level": "none"
              },
              "properties": {
                "prerequisites": [
                  "presentation",
                  "relationships",
                  "archive"
                ]
              }
            },
            {
              "id": "text/min-font-size",
              "shortDescription": {
                "text": "Effective font size is below the configured minimum."
              },
              "defaultConfiguration": {
                "enabled": true,
                "level": "error"
              },
              "properties": {
                "prerequisites": [
                  "text"
                ]
              }
            },
            {
              "id": "text/autofit-scale-below-minimum",
              "shortDescription": {
                "text": "Stored autofit scale reduces effective font size below the configured minimum."
              },
              "defaultConfiguration": {
                "enabled": true,
                "level": "error"
              },
              "properties": {
                "prerequisites": [
                  "text"
                ]
              }
            },
            {
              "id": "text/autofit-enabled",
              "shortDescription": {
                "text": "Runtime autofit is enabled without a persisted scale."
              },
              "defaultConfiguration": {
                "enabled": true,
                "level": "warning"
              },
              "properties": {
                "prerequisites": [
                  "text"
                ]
              }
            },
            {
              "id": "fonts/allowed",
              "shortDescription": {
                "text": "Resolved font is not in the configured allowlist."
              },
              "defaultConfiguration": {
                "enabled": false,
                "level": "none"
              },
              "properties": {
                "prerequisites": [
                  "text"
                ]
              }
            }
          ]
        }
      },
      "artifacts": [
        {
          "location": {
            "uri": "a%20missing%23.pptx",
            "uriBaseId": "%SRCROOT%",
            "index": 0
          },
          "roles": [
