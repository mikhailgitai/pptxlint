          },
          "properties": {
            "pptxlintInputKey": "z-valid.pptx",
            "pptxlintDisplayPath": "z-valid.pptx",
            "pptxlintAnalysisComplete": true,
            "pptxlintSkippedRules": []
          }
        }
      ],
      "results": [
        {
          "ruleId": "package/missing-media",
          "ruleIndex": 1,
          "kind": "fail",
          "level": "error",
          "message": {
            "text": "Referenced image target \\"../media/missing.png\\" is missing."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "a%20missing%23.pptx",
                  "uriBaseId": "%SRCROOT%",
                  "index": 0
                }
              },
              "logicalLocations": [
                {
                  "name": "slide 1",
                  "fullyQualifiedName": "a missing#.pptx#part=ppt/slides/slide1.xml;slide=1;slideId=256",
                  "kind": "element",
                  "properties": {
                    "part": "ppt/slides/slide1.xml",
                    "slideNumber": 1,
                    "slideId": "256"
                  }
                }
              ],
              "properties": {
                "part": "ppt/slides/slide1.xml",
                "slideNumber": 1,
                "slideId": "256"
              }
            }
          ],
          "partialFingerprints": {
            "pptxlintFingerprint/v1": "a6b49fc2f36c485cd1e763b9bfce908423d6a87720fafe6cae0eaa7000a55051"
          },
          "properties": {
            "pptxlintStatus": "new",
            "pptxlintInputKey": "a missing#.pptx",
            "part": "ppt/slides/slide1.xml",
            "slideNumber": 1,
            "slideId": "256",
            "pptxlintEvidence": {
              "mediaKind": "image",
              "rawTarget": "../media/missing.png",
              "referencingSlide": 1,
              "relationshipId": "rId8",
              "relationshipPart": "ppt/slides/_rels/slide1.xml.rels",
              "relationshipType": "http://schemas.openxmlformats.org/officeDocument/2006/relationships/image",
              "resolvedTarget": "ppt/media/missing.png",
              "sourcePart": "ppt/slides/slide1.xml"
            }
          }
        }
      ],
      "properties": {
